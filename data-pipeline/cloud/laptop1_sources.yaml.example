# ─────────────────────────────────────────────────────────────────
# laptop1_sources.yaml.example
#
# Template for the Laptop 1 (Drugs.com PDFs) data upload config.
#
# USAGE:
#   1. Copy this file to laptop1_sources.yaml (which is gitignored)
#   2. Replace the placeholder local paths with your actual paths on Laptop 1
#   3. Run:  python data-pipeline/cloud/upload_local_to_gcs.py \
#              --config data-pipeline/cloud/laptop1_sources.yaml \
#              --parallel 8
#
# This file lists drugs.com PDFs only. DDIMDL, MIMIC-III, and Kaggle
# datasets go in laptop2_sources.yaml.
# ─────────────────────────────────────────────────────────────────

# Cloud destination
target:
  bucket: maisys-data-dev          # bucket name (without gs://)
  region: us-central1
  storage_class: COLDLINE          # COLDLINE for raw PDFs (cheap, rare-access)

# Upload behavior
options:
  parallel_uploads: 8              # tune to your Laptop 1 upload bandwidth
  chunk_size_mb: 16                # multipart chunk size
  verify_md5: true                 # compute MD5 on every file before upload
  skip_if_exists: true             # resume — don't re-upload files already present with matching MD5
  retry_attempts: 5
  retry_backoff_seconds: [1, 2, 4, 8, 16]
  manifest_path: gs://maisys-data-dev/manifests/phase_a1_manifest.json

# ─────────────────────────────────────────────────────────────────
# Source data — drugs.com PDFs on Laptop 1
# ─────────────────────────────────────────────────────────────────
sources:

  # General drug PDFs (~17,432 files)
  - name: drugs_com_general_pdfs
    local_path: /path/to/your/drugs_com/general_pdfs                   # ← REPLACE
    remote_prefix: raw/drugs_com/general_pdfs
    file_pattern: "*.pdf"
    recursive: true
    expected_min_files: 17000      # sanity check — abort if fewer than this many files found
    expected_max_files: 18000

  # Professional drug PDFs (~6,450 files)
  - name: drugs_com_professional_pdfs
    local_path: /path/to/your/drugs_com/professional_pdfs              # ← REPLACE
    remote_prefix: raw/drugs_com/professional_pdfs
    file_pattern: "*.pdf"
    recursive: true
    expected_min_files: 6000
    expected_max_files: 7000

# ─────────────────────────────────────────────────────────────────
# Notes:
#
# - Total upload from Laptop 1: ~17 GB (24,000 PDFs)
# - At 8 parallel and a reasonable home connection (~10 MB/s upload),
#   expect 4–8 hours. Resume-safe — kill and restart as needed.
# - The script verifies destination object MD5 matches local MD5 after upload.
#   If your laptop has a flaky connection, set retry_attempts higher.
# ─────────────────────────────────────────────────────────────────
