*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ═════════════════════════════════════════════════════════════════
# Docker
# ═════════════════════════════════════════════════════════════════
docker-compose.override.yml
.dockerignore.local

