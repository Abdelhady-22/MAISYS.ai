# ─────────────────────────────────────────────────────────────────
# MAISYS .gitignore — Strict no-data, no-secrets policy
# ─────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════
# DATA FILES — Never in repo. They live in cloud buckets.
# ═════════════════════════════════════════════════════════════════
*.pdf
*.csv
*.tsv
*.jsonl
*.parquet
*.db
*.sqlite
*.sqlite3
*.h5
*.npy
*.npz
*.pkl
*.pickle

# Data directories
/data/
/datasets/
/embeddings/
/cache/
/raw/
/processed/

# ═════════════════════════════════════════════════════════════════
# MODEL WEIGHTS — Cloud storage only
# ═════════════════════════════════════════════════════════════════
*.safetensors
*.bin
*.gguf
*.ckpt
*.pt
*.pth
/models/
/checkpoints/
/lora_adapters/

# ═════════════════════════════════════════════════════════════════
# SECRETS — Cloud Secret Manager / Key Vault / Secrets Manager only
# ═════════════════════════════════════════════════════════════════
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
*.pfx
*.json.key
service-account*.json
gcp-credentials*.json
azure-credentials*.json
aws-credentials*.json
kaggle.json
hf_token
.kaggle/
.aws/
.azure/
gcloud-credentials*

# Per-laptop config (these contain local paths, not committed)
data-pipeline/cloud/laptop1_sources.yaml
data-pipeline/cloud/laptop2_sources.yaml

# ═════════════════════════════════════════════════════════════════
