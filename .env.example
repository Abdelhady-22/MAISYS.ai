# ─────────────────────────────────────────────────────────────────
# MAISYS — .env.example
# Copy to .env (which is gitignored) and fill in real values for local dev.
# Real production values live in cloud Secret Manager / Key Vault / Secrets Manager.
# ─────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════
# Deployment environment
# ═════════════════════════════════════════════════════════════════
ENV=dev                                    # dev | stage | prod
CLOUD_PROVIDER=gcp                         # gcp | azure | aws
REGION=us-central1
SERVICE_NAME=                              # set per service (auth-service, drug-service, etc.)

# ═════════════════════════════════════════════════════════════════
# Cloud storage URIs (the source of truth for data)
# ═════════════════════════════════════════════════════════════════
STORAGE_BUCKET_RAW=gs://maisys-data-dev/raw
STORAGE_BUCKET_BETA=gs://maisys-data-dev/beta_training
STORAGE_BUCKET_PROCESSED=gs://maisys-data-dev/processed
STORAGE_BUCKET_KG=gs://maisys-data-dev/knowledge_graphs
STORAGE_BUCKET_MODELS=gs://maisys-data-dev/models
STORAGE_BUCKET_USER_UPLOADS=gs://maisys-data-dev/user_uploads
STORAGE_BUCKET_EXPORTS=gs://maisys-data-dev/exports
STORAGE_BUCKET_MANIFESTS=gs://maisys-data-dev/manifests

# ═════════════════════════════════════════════════════════════════
# Cloud-provider auth (one set per provider per environment)
# In real environments, these come from workload identity / OIDC, not env vars.
# ═════════════════════════════════════════════════════════════════
GOOGLE_APPLICATION_CREDENTIALS=            # path to service-account JSON (local dev only)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=                         # local dev only — prod uses IAM role
AWS_SECRET_ACCESS_KEY=                     # local dev only
AWS_REGION=us-east-1

# ═════════════════════════════════════════════════════════════════
# Databases (per service — each has its own Postgres in production)
# ═════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/maisys_dev
POSTGRES_USER=maisys
POSTGRES_PASSWORD=
POSTGRES_DB=maisys_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ═════════════════════════════════════════════════════════════════
# Redis (shared across services for cache, pub/sub, rate limit)
# ═════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ═════════════════════════════════════════════════════════════════
# Qdrant (vector DB for RAG)
# ═════════════════════════════════════════════════════════════════
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_DRUG=drug_rag
QDRANT_COLLECTION_MEDICAL=medical_rag
QDRANT_COLLECTION_PAPER=paper_rag

# ═════════════════════════════════════════════════════════════════
# RabbitMQ (async task queue)
# ═════════════════════════════════════════════════════════════════
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

# ═════════════════════════════════════════════════════════════════
# JWT (auth-service issues, all services validate)
# ═════════════════════════════════════════════════════════════════
JWT_SECRET=                                # 32+ random bytes, base64-encoded
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=maisys

# ═════════════════════════════════════════════════════════════════
# OAuth providers (auth-service only)
# ═════════════════════════════════════════════════════════════════
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# ═════════════════════════════════════════════════════════════════
# LLM providers (via model-router-service + shared/llm_client)
# ═════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o
LLM_FALLBACK_MODEL=claude-3-5-sonnet
LLM_CHEAP_MODEL=gpt-4o-mini

# ═════════════════════════════════════════════════════════════════
# vLLM (Beta fine-tuned model serving)
# ═════════════════════════════════════════════════════════════════
VLLM_SERVER_URL=http://vllm:8000
VLLM_API_KEY=
VLLM_MODEL_NAME=maisys-beta-v1

# ═════════════════════════════════════════════════════════════════
# Embedding models
# ═════════════════════════════════════════════════════════════════
EMBEDDING_MODEL_GENERIC=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_MEDICAL=NeuML/pubmedbert-base-embeddings
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION_GENERIC=384
EMBEDDING_DIMENSION_MEDICAL=768

# ═════════════════════════════════════════════════════════════════
# External APIs (Drug, Symptom, Lab services)
# ═════════════════════════════════════════════════════════════════
RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST
INFERMEDICA_APP_ID=
INFERMEDICA_APP_KEY=
ENDLESS_MEDICAL_API_KEY=
PUBMED_API_KEY=

# ═════════════════════════════════════════════════════════════════
# Beta training (only set in fine-tuning environments)
# ═════════════════════════════════════════════════════════════════
KAGGLE_USERNAME=
KAGGLE_KEY=
HUGGINGFACE_TOKEN=
WANDB_API_KEY=

# ═════════════════════════════════════════════════════════════════
# Email & SMS (notification-service)
# ═════════════════════════════════════════════════════════════════
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMAIL_FROM_ADDRESS=noreply@maisys.example.com

# ═════════════════════════════════════════════════════════════════
# Frontend
# ═════════════════════════════════════════════════════════════════
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
VITE_ENVIRONMENT=dev
VITE_SENTRY_DSN=

# ═════════════════════════════════════════════════════════════════
# Observability
# ═════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
SENTRY_DSN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ═════════════════════════════════════════════════════════════════
# Service ports (local dev)
# ═════════════════════════════════════════════════════════════════
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8001
CHATBOT_SERVICE_PORT=8002
DRUG_SERVICE_PORT=8003
SYMPTOM_SERVICE_PORT=8004
LAB_SERVICE_PORT=8005
RESEARCH_SERVICE_PORT=8006
TRANSLATION_SERVICE_PORT=8007
EXPORT_SERVICE_PORT=8008
SAFETY_SERVICE_PORT=8009
NOTIFICATION_SERVICE_PORT=8010
MODEL_ROUTER_SERVICE_PORT=8011
ADMIN_SERVICE_PORT=8012

# ═════════════════════════════════════════════════════════════════
# Feature flags
# ═════════════════════════════════════════════════════════════════
FEATURE_BETA_SYMPTOM_ENABLED=false         # true once Beta model is trained
FEATURE_VOICE_INPUT_ENABLED=true
FEATURE_VISUAL_GENERATION_ENABLED=true
FEATURE_TRIPLE_CONSENT_REQUIRED=true
