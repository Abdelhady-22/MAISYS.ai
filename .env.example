# ─────────────────────────────────────────────────────────────────
# MAISYS — Local development environment variables
#
# Copy to .env (gitignored) and adjust as needed:
#     cp .env.example .env
#
# This file lists ONLY variable names + safe placeholders.
# Real secrets go in cloud Secret Manager / Key Vault / Secrets Manager
# in staging and production — NEVER in this repo.
# ─────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════════════
# Infrastructure (docker-compose interpolates these)
# ════════════════════════════════════════════════════════════════
POSTGRES_USER=maisys
POSTGRES_PASSWORD=changeme_local_only
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest


# ════════════════════════════════════════════════════════════════
# auth-service — runtime configuration
# Every variable below is read by services/auth-service/main.py.
# ════════════════════════════════════════════════════════════════

# Core
APP_ENV=development
LOG_LEVEL=INFO

# Database (the `auth` database is created by the postgres init script)
DATABASE_URL=postgresql+asyncpg://maisys:changeme_local_only@postgres:5432/auth

# JWT
JWT_SECRET=local-dev-jwt-secret-CHANGE-IN-STAGING-AND-PROD
JWT_ISSUER=maisys
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Login
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_OTP_REQUIRED_ROLES=admin,super_admin

# Password reset
PASSWORD_RESET_TTL_MINUTES=30

# OAuth (leave blank locally; set real client IDs in staging/prod via secret store)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# HTTP / runtime
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=4

# Rate limiting (slowapi)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# CORS — comma-separated origins, or "*" for any
CORS_ORIGINS=*


# ════════════════════════════════════════════════════════════════
# Phase-2 placeholders
# Not read by auth-service today. Listed here so the .env file is
# stable across phases — when these services come online, the values
# below are the local-compose defaults.
# ════════════════════════════════════════════════════════════════

# Redis URL — auth-service will use this for rate-limit storage and
# token blacklist once those are added.
REDIS_URL=redis://redis:6379/0

# notification-service is not running locally yet. When it ships,
# auth-service will POST OTP / reset emails here instead of logging
# them as a stub. Until then, this value is informational only.
NOTIFICATION_SERVICE_URL=http://notification-service:8002
